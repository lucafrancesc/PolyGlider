# Copy this file to .env and fill in values for your environment.
# .env is gitignored — never commit real credentials.

# ── RabbitMQ ────────────────────────────────────────────────────────────────
# Used by docker-compose, the Scala engine, and the C# gateway.
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ── Postgres ────────────────────────────────────────────────────────────────
# Used by docker-compose, the Scala engine, and the MCP server.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=polyglider_inventory

# ── Scala engine — DB connection ────────────────────────────────────────────
# Override when the DB isn't running via docker-compose defaults.
DB_URL=jdbc:postgresql://localhost:5432/polyglider_inventory
DB_USER=postgres
DB_PASSWORD=postgres

# ── C# gateway — RabbitMQ connection ────────────────────────────────────────
# ASP.NET Core reads these as RabbitMQ:Host / RabbitMQ:User / etc.
RABBITMQ__HOST=localhost
RABBITMQ__PORT=5672
RABBITMQ__USER=guest
RABBITMQ__PASSWORD=guest

# ── C# gateway — security ───────────────────────────────────────────────────
# Leave blank to disable API key auth (dev default).
GATEWAY__API_KEY=
# Requests per minute per client IP before 429 is returned (default 100). Enforced globally
# across all gateway replicas via the Redis-backed limiter, not per-instance.
GATEWAY__RATELIMITPERMINUTE=100

# ── C# gateway — Redis (rate limiter) ───────────────────────────────────────
REDIS__CONNECTIONSTRING=localhost:6379

# ── MCP server ───────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/polyglider_inventory
GATEWAY_URL=http://localhost:5187
