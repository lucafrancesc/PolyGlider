# Copy this file to .env and fill in values for your environment.
# .env is gitignored — never commit real credentials.

# ── RabbitMQ ────────────────────────────────────────────────────────────────
# Used by docker-compose, the Scala engine, and the C# gateway.
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ── Postgres ────────────────────────────────────────────────────────────────
# Used by docker-compose, the Scala engine, and the MCP server.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=polyglider_inventory

# ── Scala engine — DB connection ────────────────────────────────────────────
# Override when the DB isn't running via docker-compose defaults.
DB_URL=jdbc:postgresql://localhost:5432/polyglider_inventory
DB_USER=postgres
DB_PASSWORD=postgres

# ── C# gateway — RabbitMQ connection ────────────────────────────────────────
# ASP.NET Core reads these as RabbitMQ:Host / RabbitMQ:User / etc.
RABBITMQ__HOST=localhost
RABBITMQ__PORT=5672
RABBITMQ__USER=guest
RABBITMQ__PASSWORD=guest

# ── C# gateway — security ───────────────────────────────────────────────────
# Leave blank to disable API key auth (dev default). Note: no underscore inside
# "ApiKey" -- this binds to appsettings.json's Gateway:ApiKey, and ASP.NET Core's
# double-underscore env var convention only maps to the ':' section separator,
# not to underscores inside a single key name.
#
# Used directly when running the gateway via `dotnet run` (host mode).
Gateway__ApiKey=
# Requests per minute per client IP before 429 is returned (default 100). Enforced globally
# across all gateway replicas via the Redis-backed limiter, not per-instance.
#
# Used directly when running the gateway via `dotnet run` (host mode).
GATEWAY__RATELIMITPERMINUTE=100

# Same two settings, but for the containerized run mode (`docker compose --profile
# containerized up`) — docker-compose.yml substitutes these into the gateway container's
# Gateway__ApiKey / GATEWAY__RATELIMITPERMINUTE env vars at startup.
GATEWAY_API_KEY=
GATEWAY_RATELIMITPERMINUTE=100

# ── C# gateway — Redis (rate limiter) ───────────────────────────────────────
REDIS__CONNECTIONSTRING=localhost:6379

# ── MCP server ───────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/polyglider_inventory
GATEWAY_URL=http://localhost:5187

# ── Distributed tracing (Jaeger, OTLP) ──────────────────────────────────────
# Both the gateway and the engine default to http://localhost:4317 (Jaeger's OTLP gRPC
# port, published by docker-compose.yml) if these are left unset -- only override if Jaeger
# runs somewhere else. The C# gateway reads OTEL__EXPORTERENDPOINT; the Scala engine reads
# the standard OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_SERVICE_NAME env vars directly.
OTEL__EXPORTERENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=processing-engine-scala
