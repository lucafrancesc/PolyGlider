{
  "title": "PolyGlider Resilience",
  "uid": "polyglider-resilience",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Messages processed (rate)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(polyglider_messages_processed_total[1m])", "legendFormat": "processed/s" }
      ]
    },
    {
      "id": 2,
      "title": "Failure rate by classification",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(polyglider_transient_failures_total[1m])", "legendFormat": "transient/s" },
        { "expr": "rate(polyglider_permanent_failures_total[1m])", "legendFormat": "permanent/s" },
        { "expr": "rate(polyglider_retries_total[1m])", "legendFormat": "retries/s" }
      ]
    },
    {
      "id": 3,
      "title": "Circuit breaker state (postgres-write)",
      "type": "state-timeline",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "polyglider_circuit_breaker_state{name=\"postgres-write\"}", "legendFormat": "{{name}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "closed", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "half-open", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "open", "color": "red" } } }
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Queue depths (dlx / needs-attention)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "polyglider_dlq_depth{queue=\"dlx.orders.placed\"}", "legendFormat": "dlx.orders.placed" },
        { "expr": "polyglider_dlq_depth{queue=\"needs-attention.orders.placed\"}", "legendFormat": "needs-attention.orders.placed" },
        { "expr": "polyglider_dlq_depth{queue=\"orders.placed\"}", "legendFormat": "orders.placed (consumer lag)" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 50, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Gateway: orders received/rejected (rate)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "rate(gateway_orders_received_total[1m])", "legendFormat": "received/s" },
        { "expr": "sum by (reason) (rate(gateway_orders_rejected_total[1m]))", "legendFormat": "rejected/s ({{reason}})" }
      ]
    },
    {
      "id": 6,
      "title": "Gateway: request latency (p50/p95/p99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{endpoint}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{endpoint}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99 {{endpoint}}" }
      ]
    },
    {
      "id": 7,
      "title": "Gateway: buffer used / RabbitMQ connected",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "gateway_order_buffer_used", "legendFormat": "buffer used" },
        { "expr": "gateway_rabbitmq_connected", "legendFormat": "rabbitmq connected (0/1)" }
      ]
    },
    {
      "id": 8,
      "title": "MCP server: tool calls (rate) and duration (p95)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "sum by (tool, outcome) (rate(mcp_tool_calls_total[1m]))", "legendFormat": "{{tool}} ({{outcome}})/s" },
        { "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(mcp_tool_call_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{tool}}" }
      ]
    },
    {
      "id": 9,
      "title": "SLO: rolling 1h compliance (target: see docs/slo.md)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }
    },
    {
      "id": 10,
      "title": "Processing latency compliance (target 99%)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 33 },
      "targets": [
        { "expr": "slo:processing_latency:compliance_ratio_1h", "legendFormat": "compliance" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.99, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "DLQ depth compliance (target 99.9%)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 33 },
      "targets": [
        { "expr": "slo:dlq_depth:compliance_ratio_1h", "legendFormat": "compliance" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.999, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Circuit breaker open time, last 1h (target ≤ 60s)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 33 },
      "targets": [
        { "expr": "slo:circuit_breaker_open:seconds_1h", "legendFormat": "seconds open" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 60, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "title": "Error budget remaining: processing latency",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 39 },
      "targets": [
        { "expr": "slo:processing_latency:error_budget_remaining_ratio_1h", "legendFormat": "budget remaining" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": -1,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0, "color": "yellow" },
              { "value": 0.5, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "title": "Error budget remaining: DLQ depth",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 39 },
      "targets": [
        { "expr": "slo:dlq_depth:error_budget_remaining_ratio_1h", "legendFormat": "budget remaining" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": -1,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0, "color": "yellow" },
              { "value": 0.5, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 15,
      "title": "Error budget remaining: circuit breaker open time",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 39 },
      "targets": [
        { "expr": "slo:circuit_breaker_open:error_budget_remaining_ratio_1h", "legendFormat": "budget remaining" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": -1,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0, "color": "yellow" },
              { "value": 0.5, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 16,
      "title": "Error budget remaining over time (burn rate)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 45 },
      "targets": [
        { "expr": "slo:processing_latency:error_budget_remaining_ratio_1h", "legendFormat": "processing latency" },
        { "expr": "slo:dlq_depth:error_budget_remaining_ratio_1h", "legendFormat": "dlq depth" },
        { "expr": "slo:circuit_breaker_open:error_budget_remaining_ratio_1h", "legendFormat": "circuit breaker open time" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": -1,
          "max": 1
        }
      }
    }
  ]
}
